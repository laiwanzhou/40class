{
  "protocol_version": "p25-v1-fixed-before-training",
  "source": {
    "cache_dir": "aligned_multimodal/runs/p22_joint_pooled_fusion/cache",
    "outer_folds": 3,
    "sample_alignment": "explicit sample_id join",
    "rerun_encoders": false
  },
  "modalities": {
    "skeleton": 512,
    "depth": 1024,
    "thermal": 1024,
    "imu": 320
  },
  "variants": {
    "P25-C": {
      "action_ce_weight": 1.0,
      "cross_subject_supcon_weight": 0.0,
      "subject_adversarial_ce_weight": 0.0
    },
    "P25-S": {
      "action_ce_weight": 1.0,
      "cross_subject_supcon_weight": 0.1,
      "subject_adversarial_ce_weight": 0.0
    },
    "P25-A": {
      "action_ce_weight": 1.0,
      "cross_subject_supcon_weight": 0.1,
      "subject_adversarial_ce_weight": 0.05
    }
  },
  "adapter": {
    "hidden_dim": 128,
    "representation_dim": 64,
    "dropout": 0.2,
    "representation_normalization": "L2",
    "action_classes": 40,
    "subject_head_inference": false
  },
  "training": {
    "epochs": 50,
    "batch_size": 128,
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.001,
    "seed": 20260729,
    "checkpoint_selection": "fixed final epoch 50",
    "held_fold_early_stopping": false,
    "held_fold_evaluation": "final epoch only",
    "hyperparameter_sweep": false,
    "deterministic_algorithms": true
  },
  "sampler": {
    "type": "class-subject balanced",
    "classes_per_batch": 32,
    "subject_slots_per_class": 4,
    "steps_per_epoch": "ceil(number of present outer-train samples / 128)",
    "subject_slot_fallback": "include every available subject once, then fill remaining slots with replacement when a class has fewer than four train subjects",
    "sample_within_class_subject": "uniform with replacement across steps",
    "same_batches_across_variants": true
  },
  "supervised_contrastive": {
    "temperature": 0.1,
    "positive_rule": "same action class and different subject",
    "same_subject_positive": false,
    "anchors_without_positive": "excluded from contrastive mean and counted"
  },
  "gradient_reversal": {
    "schedule": "linear",
    "start": 0.0,
    "end": 0.05,
    "epoch_formula": "0.05 * (epoch_index / 49)",
    "note": "P25-A also multiplies subject CE by 0.05, so maximum adapter-side adversarial coefficient is 0.0025"
  },
  "subject_probe": {
    "scope": "outer-train subjects only",
    "model": "StandardScaler + LogisticRegression",
    "C": 1.0,
    "solver": "lbfgs",
    "max_iter": 2000,
    "cv": "StratifiedKFold",
    "n_splits": 3,
    "shuffle": true,
    "seed": 20260729,
    "selection_use": false
  },
  "prototype": {
    "protocol": "identical to P23",
    "distances": [
      "cosine",
      "standardized_euclidean"
    ],
    "gate_distance": "standardized_euclidean"
  },
  "evaluation": {
    "small_action_ids": [
      1,
      2,
      6,
      7,
