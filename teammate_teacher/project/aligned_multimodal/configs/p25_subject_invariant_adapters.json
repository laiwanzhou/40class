      12,
      13
    ]
  },
  "gates": {
    "overall_delta_pp_min": 2.0,
    "hard_delta_pp_min": 3.0,
    "improved_outer_fold_count_min": 2,
    "prototype_gap_reduction_pp_min": 5.0,
    "prototype_same_subject_drop_pp_max": 5.0,
    "subject_probe_drop_pp_min": 10.0,
    "passing_modality_count_min": 2,
    "adversarial_action_degradation_rule": "lower subject probe with lower action accuracy is deletion of action information and cannot pass"
  },
  "forbidden": [
    "four-modality learned feature concatenation",
    "encoder rerun or unfreezing",
    "P22-B",
    "Transformer",
    "Local ROI",
    "P12 modification",
    "held-fold model selection",
    "post-result weight, epoch, seed, or structure changes"
  ]
}
